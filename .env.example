DB_URL=jdbc:postgresql://localhost:5432/metacloth
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=1440
CORS_ALLOWED_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
ADMIN_EMAIL=admin@metacloth.local
ADMIN_PASSWORD=ChangeMe_123!

# Cloudflare R2 Object Storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=shade-atelier-production
R2_PUBLIC_BASE_URL=
